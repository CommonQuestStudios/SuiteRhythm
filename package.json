{
  "name": "SuiteRhythm",
  "version": "3.6.4",
  "private": true,
  "homepage": "https://suiterhythm.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommonQuestStudios/SuiteRhythm.git"
  },
  "bugs": {
    "url": "https://github.com/CommonQuestStudios/SuiteRhythm/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "catalog:check": "node scripts/retag-catalog.js --check",
    "catalog:write": "node scripts/retag-catalog.js --write",
    "catalog:health": "node scripts/check-catalog-health.mjs",
    "catalog:health:r2": "node scripts/check-catalog-health.mjs --require-r2",
    "keywords:check": "node scripts/enrich-keywords.js --check",
    "keywords:write": "node scripts/enrich-keywords.js --write",
    "sounds:migrate-prefix": "node scripts/migrate-sound-prefix.mjs",
    "sounds:plan": "node scripts/generate-sounds-batch2.js --dry-run",
    "sounds:generate": "node scripts/generate-sounds-batch2.js",
    "sounds:priority:plan": "node scripts/generate-priority-sounds.js --dry-run",
    "sounds:priority:generate": "node scripts/generate-priority-sounds.js",
    "sounds:needed:plan": "node scripts/generate-needed-sounds.js --dry-run",
    "sounds:needed:generate": "node scripts/generate-needed-sounds.js",
    "sounds:gaps:plan": "node scripts/generate-coverage-gaps.js --dry-run",
    "sounds:gaps:generate": "node scripts/generate-coverage-gaps.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@supabase/supabase-js": "^2.101.1",
    "ffmpeg-static": "^5.3.0",
    "howler": "^2.2.4",
    "next": "^15.1.2",
    "openai": "^6.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "dotenv": "^17.4.0",
    "eslint": "^9",
    "eslint-config-next": "^15.1.2",
    "vitest": "^4.1.5"
  }
}
