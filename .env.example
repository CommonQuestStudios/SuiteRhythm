# SuiteRhythm Environment Variables
# Copy this file to .env.local and fill in real values
# Add these same vars in Vercel Dashboard → Settings → Environment Variables

# ── Supabase ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── API protection ───────────────────────────────────────
# Signs the short lived tokens the browser uses for provider backed routes.
# Any strong random string, 32+ chars.
API_AUTH_SECRET=
# Public beta: when true (default) provider routes accept anonymous callers and
# rely on rate limits. Set to false to require signed tokens.
PUBLIC_BETA_ACCESS=true
# Required for admin only mutations such as promoting generated sounds into
# the shared catalog. Sent as the `x-admin-secret` header. Unset = disabled.
ADMIN_API_SECRET=

# ── Site ─────────────────────────────────────────────────
# Canonical public origin used for metadata, sitemap, and analytics.
NEXT_PUBLIC_SITE_URL=https://suiterhythm.vercel.app

# ── OpenAI (server-side only — never prefix with NEXT_PUBLIC_) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_MAX_FILE_MB=25

# ── Studio Mode render/export ───────────────────────
# Optional: override the bundled ffmpeg-static binary with a system ffmpeg path.
FFMPEG_PATH=
STUDIO_DIRECT_TRANSCRIBE_MAX_FILE_MB=4
STUDIO_TRANSCRIBE_UPLOAD_MAX_FILE_MB=100
STUDIO_TRANSCRIBE_AUDIO_BITRATE=64k
STUDIO_RENDER_MAX_FILE_MB=100
STUDIO_RENDER_TIMEOUT_MS=120000

# ── Cloudflare R2 (server-side only) ──────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=SuiteRhythm-sounds
# Origin the /r2-audio proxy forwards to. Required for catalog audio to resolve.
R2_PUBLIC_URL=https://your-r2-public-bucket-url.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-r2-public-bucket-url.r2.dev

# Custom domain bound to the R2 bucket, with a CORS policy allowing GET/HEAD
# from your app origins. When set, the browser fetches audio directly from
# Cloudflare and skips the Next.js proxy hop. Leave blank to keep using /r2-audio.
# Do NOT point this at a pub-*.r2.dev URL: that endpoint is rate limited and
# has no CORS policy, so direct requests will fail.
NEXT_PUBLIC_R2_CDN_URL=

# ── ElevenLabs TTS (server-side only) ────────────────
# Must be a real API key that starts with sk_ and is 51 characters long, not an API key ID.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ── AI Sound Generation Fallback (ElevenLabs, server-side only) ──────
# Last-resort fallback: only called after a genuine miss in the normal
# SuiteRhythm sound library + generated-sound cache. See
# lib/modules/elevenlabs-generation-manager.js for the full pipeline.
AI_SOUND_FALLBACK_ENABLED=true
# Confidence floor (0-1) below which the AI's "missingSound" report is
# discarded instead of triggering a paid generation.
SOUND_MATCH_THRESHOLD=0.55
# How often (ms) to re-check ElevenLabs credit/subscription status while
# generation is available. Not checked before every single sound.
ELEVENLABS_CREDIT_CHECK_INTERVAL_MS=300000
# How often (ms) to re-check credits once the circuit breaker has opened
# (depleted). Longer than the normal interval on purpose.
ELEVENLABS_DEPLETED_RECHECK_INTERVAL_MS=1800000
# Minimum gap (ms) between generation requests for the same/similar cue.
ELEVENLABS_GENERATION_COOLDOWN_MS=10000
# Stop generating once remaining credits fall at/below this reserve so
# SuiteRhythm never burns every last credit. Leave at 0 to disable the
# reserve check (only the account's own limit applies).
ELEVENLABS_MINIMUM_CREDIT_RESERVE=1000
# ElevenLabs Sound Generation calls allowed in flight at once.
MAX_CONCURRENT_AI_SOUND_GENERATIONS=1
# One-shot SFX / ambience-loop generation durations (seconds). ElevenLabs
# Sound Generation supports up to ~22s.
ELEVENLABS_SFX_DURATION_SECONDS=3
ELEVENLABS_AMBIENCE_DURATION_SECONDS=12
AI_SOUND_MAX_PROMPT_LENGTH=200
# How many times a generated sound must be reused before it is promoted
# into the shared `sounds` catalog for everyone. Minimum 2.
AI_SOUND_AUTO_PROMOTE_HITS=3

# ── API Auth (server-side only) ──────────────────────
# Random 32+ char string used to sign API tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_SECRET=

# ── Pixabay Audio API (server-side only) ─────────────
PIXABAY_API_KEY=your-pixabay-api-key
